# Cloudflare Pages — WEBSITE STANDARD v2.0 §3 캐시 정책 + Early Hints(히어로 LCP)
/
  Link: </slides/family.webp>; rel=preload; as=image; fetchpriority=high
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Permissions-Policy: geolocation=(), microphone=(), camera=()

# _next/static/* 는 콘텐츠 해시 파일명이라 내용이 바뀌면 URL 이 바뀐다 — immutable 안전.
# 규칙이 없으면 CF 존 Browser Cache TTL(4h) 이 적용돼 재방문마다 CSS/JS 를 다시 받았다.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# 블로그 OG/썸네일 — 파일명이 slug 고정이라 제목이 바뀌면 같은 경로의 내용이 바뀐다.
# 파일명 버스팅이 불가능하므로 immutable 을 걸지 않는다(위 /*.png 규칙보다 뒤에 둔다).
/og/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
